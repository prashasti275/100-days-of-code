//Q55: Write a program to print all the prime numbers from 1 to n.

#include <stdio.h>

int main(void)
{
    int n, i, j, count;

    printf("Enter the value of n: ");
    scanf("%d", &n);

    for (i = 2; i <= n; i++)
    {
        count = 0;

        for (j = 1; j <= i; j++)
        {
            if (i % j == 0)
            {
                count++;
            }
        }

        if (count == 2)
        {
            printf("%d ", i);
        }
    }

    return 0;
}



//Q81: Count characters in a string without using built-in length functions.

#include <stdio.h>

int main(void)
{
    char str[100];
    int i = 0, count = 0;

    printf("Enter a string: \n");
    scanf("%s", str);

    while (str[i] != '\0')
    {
        count++;
        i++;
    }

    printf("Number of characters = %d\n", count);

    return 0;
}


//Q82: Print each character of a string on a new line.

#include <stdio.h>

int main(void)
{
    char str[100];
    int i = 0;

    printf("Enter a string: \n");
    scanf("%s", str);

    while (str[i] != '\0')
    {
        printf("%c\n", str[i]);
        i++;
    }

    return 0;
}
